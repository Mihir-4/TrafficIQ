# Environment variables & Secrets (NEVER commit secrets/keys)
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml

# Non-deployment files (Notebooks, Tests, Specs, Documentation)
notebooks/
test/
tests/
project.md
project_status/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Datasets & Archives
dataset/
*.zip
*.tar.gz
*.7z

# Processed / Generated Output Dumps
outputs/videos/*
outputs/logs/*
outputs/csv/*
outputs/reports/*
outputs/Session_*
outputs/LiveSession_*
!outputs/videos/.gitkeep
!outputs/logs/.gitkeep
!outputs/csv/.gitkeep
!outputs/reports/.gitkeep

# SQLite database runtime state
database/traffic.db

# Virtual Environments
venv/
env/
.venv/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
